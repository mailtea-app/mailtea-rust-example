# Your Mailtea API key: https://studio.mailtea.app/api-keys
MAILTEA_API_KEY=mt_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Overrides the API host, which defaults to https://api.mailtea.app.
# MAILTEA_API_BASE_URL=https://api.mailtea.app

# Must be an address on a domain you have verified in Mailtea.
MAILTEA_FROM="Acme <hello@acme.com>"

# Where to send. Never use @example.com — it has no MX record.
MAILTEA_TO=reader@yourdomain.com

# Optional; defaults to "Hello from Rust".
# MAILTEA_SUBJECT="Hello from Rust"
